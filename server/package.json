{
  "name": "demension-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/scripts', {recursive:true}); fs.copyFileSync('src/scripts/deploy-awg.sh', 'dist/scripts/deploy-awg.sh');\"",
    "start": "node dist/index.js",
    "reset-admin": "node dist/cli/reset-admin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.3",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
